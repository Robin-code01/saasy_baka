# Copy this file to backend/.env and set the real API key there.
# backend/.env is ignored by Git and must never be committed.
OPENAI_API_KEY=
OPENAI_TENDER_MODEL=gpt-4o-mini
TENDER_ASSESSMENT_PROMPT_VERSION=2026-09-26

# Set true only to run a local, no-cost fake assessment. It never calls OpenAI.
TENDER_ASSESSMENT_FAKE_MODE=false

# Optional: set this if the company profile is stored outside this repository.
# TENDER_COMPANY_CONTEXT_PATH=/absolute/path/to/company_profile.md
